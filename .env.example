# PostgreSQL Configuration (Matches local PostgreSQL 18.6)
POSTGRES_IMAGE=postgres:18-alpine
POSTGRES_USER=erp_admin
POSTGRES_PASSWORD=StrongProductionPassword2026!

# ASP.NET Core Runtime Environment
ASPNETCORE_ENVIRONMENT=Production

# JWT Configuration (Minimum 32 characters for HMAC-SHA256)
JWT_KEY=healthcare-erp-super-secret-jwt-key-2026!
JWT_ISSUER=healthcare-erp-api
JWT_AUDIENCE=healthcare-erp-clients

# Telehealth Video Server Hosting
# Option A: Public Jitsi (https://meet.jit.si)
# Option B: Self-Hosted VPS (e.g., https://jitsi.yourdomain.com)
VIDEO_SERVER_URL=https://meet.jit.si
